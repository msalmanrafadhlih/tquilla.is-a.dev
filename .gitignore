target/
.vscode/
.devenv/
.direnv/

# Cargo.lock and flake.lock are committed on purpose: this workspace only
# produces binaries (never a published library), and Nix flakes are meant
# to pin exact input versions — both should be reproducible, not ignored.

# Generated by the Tailwind CLI that `dx` runs for each platform package
# (input: packages/<pkg>/tailwind.css). `asset!()` needs the file at compile
# time: desktop/mobile create an empty one in build.rs when it is missing,
# web gets it from CI / dx (the zip ships a generated copy). CI / dx overwrite it.
packages/web/assets/tailwind.css
packages/desktop/assets/tailwind.css
packages/mobile/assets/tailwind.css

# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas
# Generated by Cargo
# will have compiled files and executables
/target
.DS_Store

# These are backup files generated by rustfmt
**/*.rs.bk
